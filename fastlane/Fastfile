# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

require "rbconfig"
require "fileutils"

default_platform(:ios)

platform :ios do
  desc "Generate new screenshots"
  lane :screenshots do
    capture_screenshots
    upload_to_app_store(
      api_key: api_key,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "[CI] Check static code quality"
  lane :swift_lint do
    sh(File.expand_path("../scripts/lint.sh", __dir__).shellescape)
  end

  desc "[CI] Run ArtemisKit tests on an iOS simulator"
  lane :test do
    # Native integration tests need a scene-capable app host. The production
    # Artemis scheme retains its separate screenshot flow.
    results_path = File.expand_path("../build/test-results", __dir__)
    FileUtils.rm_rf(File.join(results_path, "logs"))
    runtimes = JSON.parse(sh("xcrun simctl list runtimes --json", log: false)).fetch("runtimes")
    runtime = runtimes.select do |candidate|
      candidate["isAvailable"] && candidate["identifier"].include?(".iOS-") &&
        Gem::Version.new(candidate.fetch("version")) >= Gem::Version.new("26.0")
    end.max_by { |candidate| Gem::Version.new(candidate.fetch("version")) }
    UI.user_error!("Install an iOS 26 or newer simulator runtime with xcodebuild -downloadPlatform iOS") unless runtime
    device_type = runtime.fetch("supportedDeviceTypes").find { |type| type["productFamily"] == "iPhone" }
    UI.user_error!("No compatible iPhone device type found for #{runtime.fetch('name')}") unless device_type
    simulator_id = sh(
      "xcrun simctl create ArtemisKitTests-#{Process.pid} #{device_type.fetch('identifier').shellescape} #{runtime.fetch('identifier').shellescape}",
      log: false
    ).strip
    sh("xcrun simctl boot #{simulator_id.shellescape}", log: false)
    sh("xcrun simctl bootstatus #{simulator_id.shellescape} -b", log: false)
    scan(
      clean: true,
      project: "Artemis.xcodeproj",
      scheme: "ArtemisKitHostedTests",
      derived_data_path: File.expand_path("../build/test-derived-data", __dir__),
      destination: "platform=iOS Simulator,id=#{simulator_id},arch=#{RbConfig::CONFIG.fetch('host_cpu')}",
      skip_detect_devices: true,
      disable_slide_to_type: false,
      parallel_testing: false,
      output_directory: results_path,
      buildlog_path: File.join(results_path, "logs"),
      result_bundle: true,
      xcargs: "-skipMacroValidation -skipPackagePluginValidation CODE_SIGNING_ALLOWED=NO",
    )
    sh("ruby", File.expand_path("../scripts/check-build-warnings.rb", __dir__), File.join(results_path, "logs", "*.log"))
  ensure
    if simulator_id
      sh("xcrun simctl shutdown #{simulator_id.shellescape}", log: false, error_callback: ->(_) {})
      sh("xcrun simctl delete #{simulator_id.shellescape}", log: false)
    end
  end

  desc "[CI] Build Artemis Scheme"
  lane :build do
    archive_logs_path = File.expand_path("../build/app-logs", __dir__)
    FileUtils.rm_rf(archive_logs_path)
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    notification_extension_identifier = app_identifier + ".ArtemisNotificationExtension"
    widget_extension_identifier = app_identifier + ".ArtemisWidgetExtension"
    team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)

    setup_ci(force: 'true')
    match(
      app_identifier: [app_identifier, notification_extension_identifier, widget_extension_identifier],
      type: 'appstore',
      git_url: ENV['MATCH_GIT_URL'],
      git_basic_authorization: ENV['MATCH_GITLAB_AUTH'],
      api_key: api_key,
      git_full_name: 'Artemis IOS',
      git_user_email: 'ls1.itg@in.tum.de',
      git_branch: "main",
      readonly: false
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      code_sign_identity: "iPhone Distribution",
      sdk: "iphoneos*",
      profile_name: "match AppStore de.tum.cit.ase.artemis",
      bundle_identifier: app_identifier,
      team_id: team_id
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      code_sign_identity: "iPhone Distribution",
      sdk: "iphoneos*",
      profile_name: "match AppStore de.tum.cit.ase.artemis.ArtemisNotificationExtension",
      bundle_identifier: notification_extension_identifier,
      team_id: team_id,
      targets: ["ArtemisNotificationExtension"]
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      code_sign_identity: "iPhone Distribution",
      sdk: "iphoneos*",
      profile_name: "match AppStore de.tum.cit.ase.artemis.ArtemisWidgetExtension",
      bundle_identifier: widget_extension_identifier,
      team_id: team_id,
      targets: ["ArtemisWidgetExtension"]
    )
    increment_build_number(
      build_number: ENV['BUILD_NUMBER'],
      xcodeproj: "Artemis.xcodeproj"
    )
    build_app(
      scheme: "Artemis",
      clean: true,
      output_name: "App.ipa",
      configuration: "Release",
      cloned_source_packages_path: ".SwiftPackages",
      derived_data_path: ".DerivedData",
      output_directory: "./build",
      buildlog_path: archive_logs_path,
      xcargs: "-skipMacroValidation -skipPackagePluginValidation",
      export_options: {
        provisioningProfiles: {
          "de.tum.cit.ase.artemis" => "match AppStore de.tum.cit.ase.artemis",
          "de.tum.cit.ase.artemis.ArtemisNotificationExtension" => "match AppStore de.tum.cit.ase.artemis.ArtemisNotificationExtension",
          "de.tum.cit.ase.artemis.ArtemisWidgetExtension" => "match AppStore de.tum.cit.ase.artemis.ArtemisWidgetExtension"
        }
      }
    )
    sh("ruby", File.expand_path("../scripts/check-build-warnings.rb", __dir__), File.join(archive_logs_path, "*.log"))
  end

  desc "[CI] Upload the newest build to TestFlight"
  lane :release do
    upload_to_testflight(
      ipa: "App.ipa",
      demo_account_required: true,
      api_key: api_key,
      # submit_beta_review: false,
      skip_waiting_for_build_processing: true
    )
  end

  lane :api_key do
    app_store_connect_api_key(
      duration: 300, # This Token is valid for 300s
      key_id: ENV['API_KEY_ID'],
      issuer_id: ENV['API_KEY_ISSUER_ID'],
      key_content: ENV['API_KEY_PASSWORD'],
      is_key_content_base64: true
    )
  end

end
